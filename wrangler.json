{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trick-or-take",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/zh",
      "/zh/",
      "/party",
      "/party/",
      "/og/*",
      "/privacy",
      "/privacy/",
      "/terms",
      "/terms/",
      "/zh/privacy",
      "/zh/privacy/",
      "/zh/terms",
      "/zh/terms/",
      "/api/*",
      "/config.js"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trick-or-take",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "AGORA_APP_ID": "",
    "POSTHOG_PROJECT_TOKEN": "",
    "POSTHOG_HOST": "https://eu.i.posthog.com"
  },
  "dev": {
    "port": 5173
  }
}
