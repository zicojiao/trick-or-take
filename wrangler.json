{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trick-or-take",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/zh",
      "/zh/",
      "/party",
      "/party/",
      "/og/*",
      "/privacy",
      "/privacy/",
      "/terms",
      "/terms/",
      "/zh/privacy",
      "/zh/privacy/",
      "/zh/terms",
      "/zh/terms/",
      "/api/*",
      "/config.js",
      "/zh-tw",
      "/zh-tw/",
      "/zh-tw/privacy",
      "/zh-tw/privacy/",
      "/zh-tw/terms",
      "/zh-tw/terms/",
      "/es",
      "/es/",
      "/es/privacy",
      "/es/privacy/",
      "/es/terms",
      "/es/terms/",
      "/ja",
      "/ja/",
      "/ja/privacy",
      "/ja/privacy/",
      "/ja/terms",
      "/ja/terms/",
      "/ko",
      "/ko/",
      "/ko/privacy",
      "/ko/privacy/",
      "/ko/terms",
      "/ko/terms/",
      "/fr",
      "/fr/",
      "/fr/privacy",
      "/fr/privacy/",
      "/fr/terms",
      "/fr/terms/",
      "/de",
      "/de/",
      "/de/privacy",
      "/de/privacy/",
      "/de/terms",
      "/de/terms/",
      "/pt",
      "/pt/",
      "/pt/privacy",
      "/pt/privacy/",
      "/pt/terms",
      "/pt/terms/",
      "/ru",
      "/ru/",
      "/ru/privacy",
      "/ru/privacy/",
      "/ru/terms",
      "/ru/terms/",
      "/it",
      "/it/",
      "/it/privacy",
      "/it/privacy/",
      "/it/terms",
      "/it/terms/",
      "/id",
      "/id/",
      "/id/privacy",
      "/id/privacy/",
      "/id/terms",
      "/id/terms/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trick-or-take",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "AGORA_APP_ID": "",
    "POSTHOG_PROJECT_TOKEN": "",
    "POSTHOG_HOST": "https://eu.i.posthog.com"
  },
  "dev": {
    "port": 5173
  }
}
